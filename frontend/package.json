{
  "name": "optica-core",
  "version": "0.2.2",
  "description": "Shared frontend core of the Optica viewers",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ypollet/Optica-core.git"
  },
  "bugs": {
    "url": "https://github.com/ypollet/Optica-core/issues"
  },
  "homepage": "https://github.com/ypollet/Optica-core#readme",
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/components/ui/*/index.ts",
    "./icons/*": "./src/components/icons/*.vue",
    "./assets/*": "./src/assets/*",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    }
  },
  "scripts": {
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "push": "npm version patch && git push",
    "push-minor": "npm version minor && git push",
    "push-major": "npm version major && git push"
  },
  "peerDependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-query": "^5.51.16",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^4.2.3",
    "mathjs": "^15.2.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.4.15",
    "vuedraggable": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "vee-validate": {
      "optional": true
    },
    "@tanstack/vue-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-query": "^5.51.16",
    "@types/color": "^4.2.0",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^4.2.3",
    "mathjs": "^15.2.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^2.6.1",
    "typescript": "^5.6.2",
    "vee-validate": "^4.15.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5",
    "vue": "^3.4.15",
    "vue-tsc": "^2.0.29",
    "vuedraggable": "^4.1.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.25.12": true
  }
